#!/bin/bash

# Загрузить .env файл с экспортом всех переменных
if [ -f .env ]; then
    set -o allexport
    source .env
    set +o allexport
    echo "✓ Loaded .env"
else
    echo "⚠ Warning: .env file not found"
fi

# Активировать pyenv-окружение из .python-version
if [ -f .python-version ]; then
    VENV="$(pyenv root)/versions/$(cat .python-version)"
    if [ -d "$VENV" ]; then
        export VIRTUAL_ENV="$VENV"
        PATH_add "$VENV/bin"
        echo "✓ Activated $(basename "$VENV")"
    else
        echo "⚠ Warning: pyenv venv $(cat .python-version) not found"
    fi
fi
