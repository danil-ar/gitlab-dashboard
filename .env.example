GITLAB_URL=https://gitlab.example.com

# Auto-select this group's projects on first open (e.g. "sogaz-lk-seller")
GITLAB_DEFAULT_GROUP=

# Base URL of your issue tracker, e.g. https://jira.example.com. Used only to
# turn an issue key from a branch name into a link in the review announcement
# copied from an MR row. Leave empty to paste the bare key instead.
JIRA_URL=

# Required: random secret for encrypting session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true when serving over HTTPS (adds Secure flag to session cookie).
# Requires SECRET_KEY — the app refuses to start without it.
SECURE_COOKIE=false

# Comma-separated origins allowed to call the API from a browser.
# Leave empty: nginx (prod) and the vite proxy (dev) both keep the API same-origin.
CORS_ORIGINS=

# DEBUG logs every GitLab call; INFO logs only requests slower than 1s
LOG_LEVEL=INFO

# Ceiling on concurrent requests to GitLab — raise it only if your instance copes
GITLAB_CONCURRENCY=10

# Docker registry prefix. Leave empty for Docker Hub, or set Nexus (with trailing slash):
# REGISTRY=nexus.sogaz.ru/
REGISTRY=

# PyPI settings. Leave empty to use public PyPI, or set Nexus:
# PIP_INDEX_URL=https://nexus.sogaz.ru/repository/pypi-group/simple
# PIP_TRUSTED_HOST=nexus.sogaz.ru
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
