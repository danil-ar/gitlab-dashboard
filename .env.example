GITLAB_URL=https://gitlab.example.com

# Auto-select this group's projects on first open (e.g. "sogaz-lk-seller")
GITLAB_DEFAULT_GROUP=

# Required: random secret for encrypting session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true when serving over HTTPS (adds Secure flag to session cookie)
SECURE_COOKIE=false

# Docker registry prefix. Leave empty for Docker Hub, or set Nexus (with trailing slash):
# REGISTRY=nexus.sogaz.ru/
REGISTRY=

# PyPI settings. Leave empty to use public PyPI, or set Nexus:
# PIP_INDEX_URL=https://nexus.sogaz.ru/repository/pypi-group/simple
# PIP_TRUSTED_HOST=nexus.sogaz.ru
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
